{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Planner",
  "mainBinaryName": "DailyPlanner",
  "version": "0.1.0",
  "identifier": "com.dailyplanner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Daily Planner",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Daily Planner — Today",
        "width": 360,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nikita Malkov",
    "copyright": "© 2026 Nikita Malkov",
    "category": "Productivity",
    "shortDescription": "Daily planner with a calendar, reminders and a tray summary",
    "longDescription": "Plan your day: tasks, multi-day projects, deadlines, preparation reminders, repeating tasks, habits and a focus timer, with a summary one click away in the system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Daily Planner",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
